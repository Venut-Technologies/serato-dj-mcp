{
  "name": "serato-dj-mcp",
  "version": "0.1.0",
  "description": "MCP server for Serato DJ libraries — search and audit tracks, inspect crates, and safely stage crate creation.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "serato",
    "serato-dj",
    "dj",
    "crates",
    "music-library",
    "sqlite"
  ],
  "homepage": "https://github.com/Venut-Technologies/serato-dj-mcp#readme",
  "bugs": {
    "url": "https://github.com/Venut-Technologies/serato-dj-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venut-Technologies/serato-dj-mcp.git"
  },
  "license": "MIT",
  "author": "Mikhail Chereshnev",
  "contributors": [
    {
      "name": "Venut Technologies",
      "email": "hello@venut.tech"
    }
  ],
  "type": "module",
  "bin": {
    "serato-dj-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check --error-on-warnings src tests",
    "format": "biome check --write src tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
