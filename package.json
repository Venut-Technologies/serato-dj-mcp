{
  "name": "serato-dj-mcp",
  "version": "0.1.1",
  "mcpName": "io.github.Venut-Technologies/serato-dj-mcp",
  "description": "Ask Claude or another AI assistant about your Serato DJ library: harmonic search by BPM and Camelot key, crate browsing, duplicate and missing-file audits, and new crates built with a preview before anything is written; runs locally and is not affiliated with Serato.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "serato",
    "serato-dj",
    "dj",
    "crates",
    "music-library",
    "sqlite",
    "modelcontextprotocol",
    "dj-library",
    "harmonic-mixing",
    "camelot",
    "bpm",
    "duplicates"
  ],
  "homepage": "https://github.com/Venut-Technologies/serato-dj-mcp#readme",
  "bugs": {
    "url": "https://github.com/Venut-Technologies/serato-dj-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venut-Technologies/serato-dj-mcp.git"
  },
  "license": "MIT",
  "author": "Mikhail Chereshnev",
  "contributors": [
    {
      "name": "Venut Technologies",
      "email": "hello@venut.tech"
    }
  ],
  "type": "module",
  "bin": {
    "serato-dj-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check --error-on-warnings src tests scripts",
    "format": "biome check --write src tests scripts",
    "demo-library": "tsx scripts/make-demo-library.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
